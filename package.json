{
  "name": "notedown",
  "private": true,
  "version": "0.7.5",
  "type": "module",
  "license": "MIT",
  "author": "Cody S.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeCody93/Notedown.git"
  },
  "homepage": "https://codecody93.github.io/Notedown/",
  "bugs": {
    "url": "https://github.com/CodeCody93/Notedown/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:embed": "vite build --config vite.config.embed.ts && vite build --config vite.config.embed-render.ts && tsc -p tsconfig.embed.json && node scripts/build-embed.mjs",
    "build:web": "npm run build && npm run build:embed && node scripts/copy-embed-to-web.mjs",
    "demo:embed": "vite --config examples/embed-demo/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "version:check": "node scripts/check-version.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "verify": "npm run version:check && npm run typecheck && npm test && npm run build:web && npm run tauri build"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/markdown": "^1.7.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "codemirror-live-markdown": "0.5.1-alpha.1",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "mammoth": "^1.12.0",
    "markdown-it": "15.0.3",
    "markdown-it-attrs": "5.0.1",
    "markdown-it-deflist": "4.0.0",
    "markdown-it-emoji": "3.1.0",
    "markdown-it-footnote": "4.0.0",
    "markdown-it-mark": "4.0.0",
    "markdown-it-sub": "2.0.0",
    "markdown-it-sup": "2.0.0",
    "markdown-it-task-lists": "2.1.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "14.1.2",
    "jsdom": "^30.0.1",
    "typescript": "~5.6.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
